{% liquid
    assign productId = product.id
    assign variantId = product.variants[0].id
    assign one_year_variant = 30135749771346
    assign two_year_variant = 32930539503698
    assign bundle_product_1 = 37737276637383
    assign variant_product = 44940605554887
    assign bundle_product_2 = 44944771612871
    assign one_year_monthly = section.settings.one_year_price | divided_by: 12.0
    assign monthly_difference = section.settings.monthly_price | minus: one_year_monthly
    assign one_year_savings = monthly_difference | times: 1200.0 | round
    assign two_year_monthly =  section.settings.two_year_price | divided_by: 24

  %}

<div class="membership_modal" id="membershipModal">
 <div class="membership_container">
  <div class="freebies_container hide-on-mobile">
   <h3>
    Upgrade Your Premier Membership Now
    & <b>Receive:</b>
  </h3>
    {% for freebie in section.blocks %}

    <div class="freebie">
     <div class="gift_image">
      {% if freebie.settings.alt_image == blank %}
      <img src="https:{{ freebie.settings.product_freebie.images[0] | image_url }}" class="{% if forloop.index0 == 0 %} warranty {% endif %}" loading="lazy">
    {% else %}
      <img src="https:{{ freebie.settings.alt_image.image | image_url }}" class="{% if freebie.settings.alt_title contains 'Warranty' %} warranty  {% endif %}" loading="lazy">
    {% endif %}
     </div>
    {% if freebie.settings.alt_price == empty %}
     {% assign price = freebie.settings.product_freebie.price %}
     {% if price < freebie.settings.product_freebie.compare_at_price %}
       {% assign price = freebie.settings.product_freebie.compare_at_price %}
     {% endif %}
   {% else %}
     {% assign price = freebie.settings.alt_price | times: 100 %}
   {% endif %}
   <span
   ><b>
     {% if freebie.settings.alt_title == empty %}
       {{ freebie.settings.product_freebie.title }}
     {% else %}
       {{ freebie.settings.alt_title }}
     {% endif %}
   </b></span
 ><span> (value {{ price | money }})</span>
    </div>
    {% endfor %}
    <p class="small-text"><em>*Availble for Active Members & Excludes Recovery Products Set at a Standard of 2 Years.</em></p>
  </div>
  <div class="options_container">
   <span class="cancel_button"><img src="{{'btn-close.svg' | asset_url}}" width="50px" height="50px">Cancel</span>
   <div class="mobile_heading hide-on-desktop">
    <h2>Upgrade Fitness App Membership now, and save:</h2>
  </div>
    <div class="options">

          <div class="column_header">
